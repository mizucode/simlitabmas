# ==========================================
# Gitignore untuk Project SIMLITABMAS (PHP)
# ==========================================

# 1. File Konfigurasi Sensitif & Environment
.env
.env.*
!.env.example
*.local.php
config/db.local.php
config/config.local.php

# 2. IDE, Text Editor & Workspace
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
.project
.buildpath
.settings/
nbproject/

# 3. File Sistem Operasi & Server Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.ftpquota

# 4. Log & Debugging
*.log
error_log
logs/

# 5. Backup & Database Dump
*.sql
*.sqlite
*.db
*.bak
*.backup
*.old
**/back/
**/backup/
*copy.php
*copy*.php

# 6. Direktori Upload, File User & Media Dinamis
file/
files/
upload/
uploads/
cetak/temp/

# 7. Temporary & Cache
tmp/
temp/
cache/
scratch/
sessions/

# 8. Dependency (Composer / Node)
vendor/
node_modules/

# 9. File Arsip / Kompresi
*.zip
*.rar
*.tar.gz
*.7z
